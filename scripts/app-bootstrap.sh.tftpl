#!/usr/bin/env bash
set -Eeuo pipefail
exec > >(tee -a /var/log/fynd-app-bootstrap.log) 2>&1

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"; }
trap 'log "ERROR: bootstrap failed"; exit 1' ERR

export DEBIAN_FRONTEND=noninteractive
for i in $(seq 1 60); do
  if ! fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

dpkg --configure -a || true
apt-get update
apt-get install -y curl ca-certificates gnupg jq docker.io docker-compose-v2 wireguard iptables python3 python3-pip python3-requests
systemctl enable --now docker

groupadd --force docker
usermod -aG docker ubuntu || true
if [ -S /var/run/docker.sock ]; then
  chown root:docker /var/run/docker.sock || true
  chmod 660 /var/run/docker.sock || true
fi
su - ubuntu -c 'docker info >/dev/null' || true
until docker info >/dev/null 2>&1; do sleep 2; done

mkdir -p /opt/fynd-devsecops/k8s /opt/fynd-devsecops/waf /opt/fynd-devsecops/state

#### The canonical manifest is generated from k8s/juice-shop.yaml at Terraform render time.
### Keep a single source of truth and write it to the app host here without a second stale copy.
cat >/opt/fynd-devsecops/k8s/juice-shop.yaml <<'YAML'
${juice_shop_manifest}
YAML

cat >/usr/local/bin/fynd-app-reconcile.sh <<'SH'
${app_reconcile_script}
SH
chmod 750 /usr/local/bin/fynd-app-reconcile.sh

/usr/local/bin/fynd-app-reconcile.sh

log "Bootstrap completed successfully"

